# ==============================================================================
# Environment Configuration Template - Manufacturing Manual Assistant
# Copy this file to .env and adjust variables as necessary for your environment.
# ==============================================================================

# Django Core Settings
SECRET_KEY=replace-with-a-secure-random-secret-key-for-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Relational Database Settings (Neon PostgreSQL / PostgreSQL 18)
# Primary configuration: Full connection string (from Neon dashboard)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Alternative discrete parameters (fallback if DATABASE_URL is not set)
DB_NAME=manufacturing_manual_assistant
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSLMODE=require

# Frontend & CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Embedding Provider Configuration ('huggingface' or 'lm_studio')
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_API_KEY=your_hugging_face_token_here
EMBEDDING_BASE_URL=

# LM Studio Local Provider (alternative local development)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5-GGUF

# ChromaDB Vector Database Configuration
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=manufacturing_manual_chunks_v1

# Document Chunking Parameters
CHUNK_TARGET_TOKENS=400
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=40
